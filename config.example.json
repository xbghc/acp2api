{
  // HTTP API 网关配置
  "server": {
    "listen_addr": ":8080",
    // 可选：配置一个或多个 API Key（同时支持 Authorization: Bearer <key> 与 x-api-key: <key>）；留空则不鉴权
    "api_keys": [],
    "read_header_timeout_seconds": 30,
    "request_timeout_seconds": 600
  },

  // ACP (Agent Client Protocol) stdio 子进程配置
  "acp": {
    // 启动 ACP 服务的命令与参数，例如：
    // - Claude Code ACP: "claude-code-acp", args: []
    // - Gemini CLI ACP:  "gemini", args: ["--experimental-acp"]
    // - Codex ACP:       "codex-acp", args: []
    // - OpenCode ACP:    "opencode", args: ["acp"]
    "command": "gemini",
    "args": ["--experimental-acp"],
    "env": {},
    "cwd": ".",
    // 可选：initialize 后自动调用 ACP authenticate 的认证方式 ID
    "auth_method_id": "",
    // 可选：新建 Session 后自动切换的默认运行模式（session/set_mode）
    "default_mode": "",
    "initialize_timeout_seconds": 30,
    "session_new_timeout_seconds": 30,

    // ACP session/request_permission 权限回调策略：
    // - "allow_all"       : 自动批准全部工具权限请求（适合受控环境下的无头 API 服务）
    // - "allow_read_only" : 仅自动批准 read/search/think/fetch 类请求，拒绝写操作与命令执行
    // - "deny_all"        : 自动拒绝全部需要审批的请求
    "permission_policy": "allow_all",

    // 是否向 ACP Agent 暴露客户端宿主机的文件读写与终端执行能力
    "capabilities": {
      "enable_fs_read": false,
      "enable_fs_write": false,
      "enable_terminal": false,
      "restrict_to_cwd": true
    },

    // 创建/加载 ACP Session 时透传的 MCP 服务器列表（支持 stdio / http / sse 三种传输类型）
    "mcp_servers": [],

    // 默认对外展示的模型名称及别名映射
    "default_model": "acp-default",
    "model_aliases": {
      "gpt-4o": "",
      "claude-sonnet-4-5": ""
    },
    "pass_through_models": true,

    // 是否将思考流输出为 OpenAI reasoning_content / Anthropic thinking
    "expose_thoughts": true,

    // Thinking / Reasoning Level 适配与非标 ACP 降级配置
    "thinking": {
      "enabled": true,
      // 可选：当 ACP 服务未在 session/new 返回标准 thought_level 时，强制指定尝试调用的 configId（如 "reasoning_effort"）
      "override_config_id": "",
      // 可选：自定义等级映射（如 {"high": "max"}）
      "level_aliases": {},
      // 当无法从 ACP 服务获取或匹配任何 thinking level 选择器时的降级策略：
      // - "auto"        : 透传 session/prompt._meta 扩展提示并静默降级，不中断请求（推荐默认）
      // - "prompt_hint" : 除 _meta 外，在提示词首部注入轻量 <thinking_guidance> 引导思考深度
      // - "ignore"      : 完全静默忽略无法识别的 thinking level
      // - "strict_error": 若底层 ACP 不支持设置 thinking level 则返回 HTTP 400 错误
      "fallback_strategy": "auto",
      "send_meta_hint": true,
      // 当 ACP 服务未发送标准 agent_thought_chunk、而是在文本流首部内联输出 <think>...</think> 时自动拆分为思考流
      "extract_inline_think_tags": true,
      // 支持解析模型名后缀指定思考等级，如 "claude-sonnet-4-5:high" 或 "gpt-5(xhigh)"
      "parse_model_suffix": true
    }
  },

  // 进程池、预热空闲 Session 池与多轮对话复用配置
  "pool": {
    "process_count": 1,
    "idle_pool_size": 3,
    "max_active_sessions": 32,
    "reuse_conversations": true,
    // 当并发请求从同一活跃会话分叉且 ACP Agent 支持 session/fork 时，使用原生 fork 克隆会话状态
    "enable_native_session_fork": true,
    "max_cached_sessions": 64,
    "idle_session_ttl_seconds": 1800,
    "cached_session_ttl_seconds": 1800,
    "max_sessions_per_process": 0
  },

  "log": {
    "level": "info",
    "format": "text"
  }
}
